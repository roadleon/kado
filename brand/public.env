# 公開版の名前と見た目。local/brand.env があれば、そちらが優先される（手元用）。
APP_NAME=Kado
DISPLAY_NAME=Kado
BUNDLE_ID=io.github.roadleon.kado
URL_SCHEME=kado
ACCENT=#4C5BD4
# バブルとメニューバーに出す SF Symbol
SYMBOL=bubble.left.fill
# アイコンの形（tools/make_icon.swift の corner または center）。ICON_FILE を指定すると、その .icns をそのまま使う
ICON_STYLE=corner
